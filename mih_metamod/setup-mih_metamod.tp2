// Made in heaven: Meta-Mod
//
// WeiDU installer

BACKUP "weidu_external/backup/mih_metamod"

AUTHOR "angel@pearlgates.net"
VERSION "v1"

//MODDER setup_tra none area_variables warn missing_extern warn missing_resref warn ict2_actions none missing_eval none overwriting_file none fun_args warn

ASK_EVERY_COMPONENT
NO_IF_EVAL_BUG
AUTO_EVAL_STRINGS

ALWAYS
  INCLUDE "mih_metamod/lib/always.tpa"
END	// ALWAYS block


LANGUAGE "English"
         "english"
	 "mih_metamod/language/english/setup-mih_metamod.tra"
	 "weidu_external/lang/mih_metamod/english/setup-mih_metamod.tra"

// Patch known bugs in installed mods

BEGIN @1

LABEL MH#MiH_Meta-Mod-Patch_Installed_Mods

REQUIRE_PREDICATE GAME_IS "bg2 bgt bgee bg2ee eet" @98

LAUNCH_ACTION_FUNCTION run
  STR_VAR
  file		= "install_bug_fixes"
  location	= "fixes"
END


// Resolve known mod conflicts

BEGIN @2

LABEL MH#-MiH_Meta-Mod-Resolve_Mod_Conflicts

REQUIRE_PREDICATE GAME_IS "bg2 bgt bgee bg2ee eet" @98

LAUNCH_ACTION_FUNCTION run
  STR_VAR
  file		= "resolve_mod_conflicts"
  location	= "crossmod"
END


// Install mod balance tweaks

BEGIN @3

LABEL MH#-MiH_Meta-Mod-Mod_Balancing_Tweaks

REQUIRE_PREDICATE GAME_IS "bg2 bgt bgee bg2ee eet" @98

LAUNCH_ACTION_FUNCTION run
  STR_VAR
  file		= "install_mod_balance_tweaks"
  location	= "balancing"
END


// Install mod convenience tweaks

BEGIN @4

LABEL MH#-MiH_Meta-Mod-Mod_Convenience_Tweaks

REQUIRE_PREDICATE GAME_IS "bg2 bgt bgee bg2ee eet" @98

LAUNCH_ACTION_FUNCTION run
  STR_VAR
  file		= "install_mod_convenience_tweaks"
  location	= "convenience"
END


// Clean up override folder

BEGIN @5

LABEL MH#-MiH_Meta-Mod-Cleanup_Override

REQUIRE_PREDICATE GAME_IS "bg2 bgt bgee bg2ee eet" @98

LAUNCH_ACTION_FUNCTION run
  STR_VAR
  file		= "cleanup_override"
  location	= "cleanup"
END


// Remove file clutter left by mods

BEGIN @99
NO_LOG_RECORD

LABEL MH#-MiH_Meta-Mod-Remove_File_Clutter

REQUIRE_PREDICATE GAME_IS "bg2 bgt bgee bg2ee eet" @98

LAUNCH_ACTION_FUNCTION run
  STR_VAR
  file		= "cleanup_files"
  location	= "cleanup"
END


